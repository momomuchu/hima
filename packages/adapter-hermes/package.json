{
  "name": "@harness/adapter-hermes",
  "version": "0.0.0",
  "private": true,
  "description": "Hermes runtime adapter for HIMA portable harness artifacts and hooks.",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "hima",
    "hermes",
    "harness",
    "coding-agents",
    "hooks"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs --shell \"tsup src/index.ts --format esm --sourcemap --clean --external @harness/core && tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist\"",
    "typecheck": "node ../../scripts/with-build-lock.mjs -- tsc --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs --shell \"corepack pnpm --filter @harness/core build && vitest run --root ../.. ../../packages/adapter-hermes/test/index.test.ts\""
  },
  "dependencies": {
    "@harness/core": "workspace:*"
  }
}
