{
  "name": "@harness/generator",
  "version": "0.0.0",
  "private": true,
  "description": "Compiles the otherskill excellence consommable into hima catalog skill entries, keyword-registry entries, and activate-Pn structural-activation skills.",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "hima",
    "harness",
    "consommable",
    "generator",
    "excellence"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs -- tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "node ../../scripts/with-build-lock.mjs -- tsc --noEmit",
    "test": "vitest run --root ../.. ../../packages/generator/test"
  },
  "dependencies": {
    "zod": "^4.4.2"
  }
}
