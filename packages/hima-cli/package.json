{
  "name": "@hima/cli",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "hima": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs -- tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "node ../../scripts/with-build-lock.mjs -- tsc --noEmit",
    "test": "vitest run --root ../.. ../../packages/hima-cli/test"
  },
  "dependencies": {
    "effect": "^3",
    "@hima/core": "workspace:*",
    "@hima/schemas": "workspace:*",
    "@hima/storage-core": "workspace:*"
  }
}
