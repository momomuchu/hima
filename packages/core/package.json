{
  "name": "@harness/core",
  "version": "0.0.0",
  "private": true,
  "description": "Core state machine, gates, risk, storage, and artifact services for HIMA.",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "hima",
    "harness",
    "coding-agents",
    "planning",
    "rms"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs -- tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "node ../../scripts/with-build-lock.mjs -- tsc --noEmit",
    "test": "vitest run --root ../.. ../../packages/core/test"
  },
  "dependencies": {
    "xstate": "^5.31.0",
    "yaml": "^2.8.4",
    "zod": "^4.4.2"
  }
}
