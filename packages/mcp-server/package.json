{
  "name": "@harness/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server exposing HIMA planning, gates, runtime, and artifact tools.",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "hima",
    "harness",
    "coding-agents",
    "mcp",
    "planning"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "harness-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs --shell \"tsup src/index.ts --format esm --sourcemap --clean --external @harness/core && tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist\"",
    "typecheck": "node ../../scripts/with-build-lock.mjs -- tsc --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs -- vitest run --root ../.. ../../packages/mcp-server/test/index.test.ts"
  },
  "dependencies": {
    "@harness/adapter-claude": "workspace:*",
    "@harness/adapter-codex": "workspace:*",
    "@harness/adapter-hermes": "workspace:*",
    "@harness/core": "workspace:*"
  }
}
